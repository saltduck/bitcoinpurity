$(package)_crate_name=$(word 1,$(subst :, ,$(1)))
$(package)_crate_version=$(word 2,$(subst :, ,$(1)))
$(package)_crate_hash=$(word 3,$(subst :, ,$(1)))
$(package)_crate_file=crate-$(call $(package)_crate_name,$(1))-$(call $(package)_crate_version,$(1)).crate
$(package)_extra_sources=$(foreach c,$($(package)_crates),$(call $(package)_crate_file,$(c)))

# Iterate in the shell to keep the command below the per-argument size limit.
define $(package)_fetch_cmds
  $(call fetch_file,$(package),$($(package)_download_path),$($(package)_download_file),$($(package)_file_name),$($(package)_sha256_hash)) && \
  for crate in $($(package)_crates); do \
    name=$$$${crate%%:*}; version_hash=$$$${crate#*:}; \
    version=$$$${version_hash%%:*}; checksum=$$$${version_hash#*:}; \
    crate_file=crate-$$$$name-$$$$version.crate; \
    $(call fetch_file,$(package),$($(package)_crates_path)/$$$$name,$$$$name-$$$$version.crate,$$$$crate_file,$$$$checksum) || exit 1; \
  done
endef

# Lay the crates out as a cargo directory source. An empty "files" map is
# accepted by cargo; the package checksum ties each crate to Cargo.lock.
define $(package)_extract_cmds
  mkdir -p $$($(package)_extract_dir) && \
  echo "$($(package)_sha256_hash)  $($(package)_source_dir)/$($(package)_file_name)" > $$($(package)_extract_dir)/.$($(package)_file_name).hash && \
  $(foreach c,$($(package)_crates),echo "$(call $(package)_crate_hash,$(c))  $($(package)_source_dir)/$(call $(package)_crate_file,$(c))" >> $$($(package)_extract_dir)/.$($(package)_file_name).hash && ) \
  $(build_SHA256SUM) -c $$($(package)_extract_dir)/.$($(package)_file_name).hash && \
  mkdir -p stratum vendor && \
  $(build_TAR) --no-same-owner --strip-components=1 -C stratum -xf $($(package)_source_dir)/$($(package)_file_name) && \
  $(foreach c,$($(package)_crates),mkdir -p vendor/$(call $(package)_crate_name,$(c))-$(call $(package)_crate_version,$(c)) && \
    $(build_TAR) --no-same-owner --strip-components=1 -C vendor/$(call $(package)_crate_name,$(c))-$(call $(package)_crate_version,$(c)) -xzf $($(package)_source_dir)/$(call $(package)_crate_file,$(c)) && \
    printf '{"files":{},"package":"%s"}' $(call $(package)_crate_hash,$(c)) > vendor/$(call $(package)_crate_name,$(c))-$(call $(package)_crate_version,$(c))/.cargo-checksum.json && ) true
endef

define $(package)_stage_cmds
  mkdir -p $($(package)_staging_prefix_dir)/share/sv2-vendor && \
  cp -R stratum vendor $($(package)_staging_prefix_dir)/share/sv2-vendor/
endef
